{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["BAM_BACKEND_URL", "NEXT_PUBLIC_APP_URL"]
    },
    "clean": {
      "cache": false
    }
  }
}
